# Salin ke .env lalu sesuaikan di server. Semua opsional.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/nama_db

# Server GPU NVIDIA (butuh image & PyTorch CUDA, lihat README bagian 4 dan 8):
# MODEL_PATH=models/best_v4.pt   # server GPU: unduh dari Drive cctv/runs/v4/weights/best.pt
# DEVICE=0
# PROCESS_FPS=15
# TRACKER=bytetrack.yaml

# Server CPU:
# PROCESS_FPS=5

# CONFIDENCE=0.4
# LOW_THRESHOLD=8
# MEDIUM_THRESHOLD=20
